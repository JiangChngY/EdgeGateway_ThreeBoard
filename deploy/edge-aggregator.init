#!/bin/sh
### BEGIN INIT INFO
# Provides:          edge-aggregator
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: EdgeGateway i.MX6ULL collector
### END INIT INFO
set -eu
DAEMON=/opt/edge-gateway/bin/edge-aggregator
PID=/run/edge-aggregator.pid
export QT_PLUGIN_PATH=/usr/lib/plugins
case "${1:-}" in
    start)
        # Explicit peer route; keep the existing TFTP/NFS/default routes.
        /sbin/ip route replace 192.168.137.3/32 via 192.168.138.2 dev eth0
        mkdir -p /opt/edge-gateway/data
        /sbin/start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile "$PID" --exec "$DAEMON" -- \
            --config /opt/edge-gateway/config/imx6ull.ini
        ;;
    stop)
        /sbin/start-stop-daemon --stop --quiet --pidfile "$PID" --exec "$DAEMON" || true
        ;;
    restart) "$0" stop; "$0" start ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
